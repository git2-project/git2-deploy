# Copy to compose/.env (next to compose.yaml) and fill in. Compose reads it
# automatically; real environment variables win over this file.

# ── Secrets (required) ──────────────────────────────────────────────────────
# Hex keeps them safe inside the Postgres connection URL.
#   openssl rand -hex 24
# Applied only when the database volume is first created; changing it later
# locks the services out. Keep this file private: chmod 600 .env
POSTGRES_PASSWORD=
#   openssl rand -hex 32     (auth-svc needs at least 32 characters)
JWT_SECRET=

# ── Where git2 listens ──────────────────────────────────────────────────────
# Loopback by default. 0.0.0.0 makes it reachable from other machines, over
# plain HTTP until the gateway with TLS lands.
GIT2_BIND=127.0.0.1
GIT2_HTTP_PORT=8080

# ── Source to build from ────────────────────────────────────────────────────
# A local checkout (relative to compose/) or a Git URL with a ref, e.g.
#   https://github.com/git2-project/git2.git#main
GIT2_SRC=../../git2
CODEPLANE_SRC=../../git2-codeplane

# Tag for the image names (ghcr.io/git2-project/<name>:<tag>).
GIT2_TAG=dev

# dev | prod
GIT2_ENVIRONMENT=prod
