# Copy to compose/.env (next to compose.yaml) and fill in. Compose reads it
# automatically; real environment variables win over this file.

# ── Secrets (required) ──────────────────────────────────────────────────────
# Hex keeps them safe inside the Postgres connection URL.
#   openssl rand -hex 24
# Applied only when the database volume is first created; changing it later
# locks the services out. Keep this file private: chmod 600 .env
POSTGRES_PASSWORD=
#   openssl rand -hex 32     (auth-svc needs at least 32 characters)
JWT_SECRET=

# ── Where git2 listens ──────────────────────────────────────────────────────
# The gateway's host address and port: the only published port. Loopback by
# default, over plain HTTP. To serve other machines, use TLS (below).
GIT2_BIND=127.0.0.1
GIT2_HTTP_PORT=8080

# ── TLS (compose.tls.yaml) ──────────────────────────────────────────────────
# docker compose -f compose.yaml -f compose.tls.yaml up -d
# HTTPS on GIT2_HTTPS_PORT; GIT2_HTTP_PORT then only redirects to HTTPS.
# With TLS, GIT2_BIND defaults to 0.0.0.0 and GIT2_HTTP_PORT to 80.
#GIT2_EXTERNAL_URL=https://git.example.com
# fullchain.pem and privkey.pem, readable by uid 65532. Not certbot's live/
# directory itself: its files are symlinks into archive/, which a bind
# mount does not follow. Copy them here on each renewal.
#GIT2_TLS_DIR=/etc/git2/tls
#GIT2_HTTPS_PORT=443

# Subnet of the Compose network. git2 core believes X-Real-IP only from it.
# Change it if it clashes with a network on this host.
GIT2_SUBNET=172.31.250.0/24

# ── Source to build from ────────────────────────────────────────────────────
# A local checkout (relative to compose/) or a Git URL with a ref, e.g.
#   https://github.com/git2-project/git2.git#main
GIT2_SRC=../../git2
CODEPLANE_SRC=../../git2-codeplane

# Tag for the image names (ghcr.io/git2-project/<name>:<tag>).
GIT2_TAG=dev

# dev | prod
GIT2_ENVIRONMENT=prod
